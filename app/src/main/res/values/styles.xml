<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Campos: hint gris que sube con el foco y borde morado (HU 3 y 5) -->
    <style name="Widget.DogApp.CampoTexto" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/morado</item>
        <item name="hintTextColor">@color/morado</item>
        <item name="android:textColorHint">@color/gris_hint</item>
    </style>

    <!-- Botón Guardar/Editar Cita: pastilla rosada, ícono a la izquierda.
         Texto gris si está inactivo y blanco bold si está activo -->
    <style name="Widget.DogApp.BotonRosado" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/selector_boton_rosado</item>
        <item name="android:textColor">@color/selector_texto_boton</item>
        <item name="iconTint">@color/selector_texto_boton</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">28dp</item>
        <item name="iconGravity">textStart</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
    </style>

    <!-- Título blanco bold de toolbars y header -->
    <style name="TextAppearance.DogApp.TituloToolbar" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Textos del ítem y del detalle -->
    <style name="TextAppearance.DogApp.NombreMascota" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/gris_titulo</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.DogApp.Sintoma" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/gris_texto</item>
    </style>

    <style name="TextAppearance.DogApp.Turno" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/rosado</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Botones flotantes: cuadrado redondeado de Material 3, como en las capturas -->
    <style name="Widget.DogApp.FabRosado" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/rosado</item>
        <item name="tint">@color/white</item>
    </style>

    <style name="Widget.DogApp.FabOscuro" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/azul_oscuro</item>
        <item name="tint">@color/white</item>
    </style>
</resources>