<?xml version="1.0" encoding="utf-8"?>
<!-- HU 1.0: Ventana Login. Fondo gris oscuro y sin toolbar (criterio 1). -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gris_oscuro">

    <!-- Criterio 2: cabeza del perro con fondo transparente, arriba a la derecha.
         El ancho es un porcentaje de la pantalla para que escale en cualquier tamaño. -->
    <ImageView
        android:id="@+id/ivPerro"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="fitEnd"
        android:src="@drawable/perro_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.75" />

    <!-- Criterio 3: título blanco bold con fuente externa, centrado bajo la imagen -->
    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/font_dogapp"
        android:text="@string/titulo_dogapp"
        android:textColor="@color/white"
        android:textSize="52sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivPerro" />

    <!-- Criterio 4: animación de huella en la parte inferior central -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieHuella"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginBottom="64dp"
        android:contentDescription="@string/desc_huella"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/huella_lottie" />

</androidx.constraintlayout.widget.ConstraintLayout>
